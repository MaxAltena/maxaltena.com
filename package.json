{
  "name": "maxaltena.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless maxaltena astro dev",
    "build": "bun run check && astro build",
    "preview": "astro preview",
    "lint": "oxlint",
