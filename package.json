    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "portless": "^0.15.6",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.0"
